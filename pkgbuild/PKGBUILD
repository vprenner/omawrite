# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=omawritev
pkgver=0.7.2
pkgrel=1
pkgdesc='Dead-simple Markdown writing app built with Qt Quick'
arch=('x86_64' 'aarch64')
url='https://github.com/vprenner/omawrite'
license=('MIT' 'OFL-1.1')
install='omawritev.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omawritev "$pkgdir/usr/bin/omawritev"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/omawritev.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omawritev.svg"
  /usr/bin/install -Dm644 "$startdir/omawritev.desktop" "$pkgdir/usr/share/applications/omawritev.desktop"
}
